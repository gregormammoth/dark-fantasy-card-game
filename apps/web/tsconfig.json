{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@dark-fantasy/shared": ["../../packages/shared/src/index.ts"],
      "@dark-fantasy/shared/*": ["../../packages/shared/src/*"],
      "@dark-fantasy/content": ["../../packages/content/src/index.ts"],
      "@dark-fantasy/content/*": ["../../packages/content/src/*"],
      "@dark-fantasy/game-engine": ["../../packages/game-engine/src/index.ts"],
      "@dark-fantasy/game-engine/*": ["../../packages/game-engine/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
