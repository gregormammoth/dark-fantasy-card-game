    {
      "id": "ritual_room",
      "name": "Ritual Room",
      "subtitle": "Ritual Room",
      "type": "danger",
      "position": {
        "x": 605,
        "y": 450
      },
      "description": "A sunken circle of stone carved with wards, candles burning along every column. This is where the ritual beneath Hollowfort was cast.",
      "image": "/locations/ritual_room.png",
      "enemies": [
        {
          "id": "demon",
          "name": "Demon",
          "tier": "Elite · Bound",
          "description": "Something the ritual called up and never fully controlled, still chained to this room.",
          "image": "/characters/demon.png",
          "defeated": false
        },
        {
          "id": "sorcerer_enemy",
          "name": "The Sorcerer",
          "tier": "Boss · Ritual",
          "description": "Refuse his errand and he will burn you where you stand. Twenty wards, two barriers every breath.",
          "image": "/characters/sorcerer.png",
          "defeated": false,
          "requiresFlag": "ritual_demon_cleared",
          "skipAutoEncounter": true,
          "deckSize": 20,
          "barrierPerTurn": 2
        }
      ],
      "npcs": [
        {
          "id": "sorcerer",
          "name": "The Sorcerer",
          "tag": "Ritual Mage",
          "description": "The mage behind the ritual, revealed once the Demon falls.",
          "lines": [
            "You put the demon down. Good. Now you work for me.",
            "I need dried lavender from the Infirmary and a lowcap mushroom from the tunnels beneath.",
            "Bring them back and I'll open the corridor. Refuse, and you can try the hard way."
          ],
          "followUpLines": [
            "Lavender. Mushroom. The circle will hold a little longer.",
            "The Inquisitor still sits on the other half of this ritual in the chapel.",
            "Kill him, and the wards stop answering to anyone but me. The corridor is yours."
          ],
          "image": "/characters/sorcerer.png",
          "talked": false,
          "grantsQuestId": "gather_ritual_ingredients",
          "requiresFlag": "ritual_demon_cleared"
        }
      ],
      "interactions": [
        {
          "id": "attack_demon",
          "action": "ATTACK",
          "label": "Fight the Demon",
          "requiresEnemy": true,
          "targetId": "demon",
          "once": true
        },
        {
          "id": "talk_sorcerer",
          "action": "TALK",
          "label": "Talk to the Sorcerer",
          "requiresNpc": true,
          "targetId": "sorcerer",
          "once": true,
          "requiresFlag": "ritual_demon_cleared"
        },
        {
          "id": "attack_sorcerer",
          "action": "ATTACK",
          "label": "Fight the Sorcerer",
          "requiresEnemy": true,
          "targetId": "sorcerer_enemy",
          "once": true,
          "requiresFlag": "ritual_demon_cleared"
        },
        {
          "id": "explore_ritual_room",
          "action": "EXPLORE",
          "label": "Study the glowing circle",
          "once": true
        }
      ],
