  "exitLocationId": "exit_gate",
  "questDefinitions": [
    {
      "id": "kill_warden",
      "name": "The Warden Must Die",
      "description": "The Dead Anarchist wants the Prison Warden dead. He waits in the tower beyond the courtyard.",
      "targetEnemyId": "prison_warden_boss",
      "targetLocationId": "warden_tower",
      "branchId": "warden_tower"
    },
    {
      "id": "gather_ritual_ingredients",
      "name": "Ingredients for the Circle",
      "description": "The Sorcerer needs dried lavender from the Infirmary and a lowcap mushroom from the Underground Tunnels before he will let you pass.",
      "requiredLocationIds": [
        "infirmary",
        "underground_tunnels"
      ],
      "completeOnReturnTo": "ritual_room",
      "grantsQuestIdOnComplete": "kill_inquisitor",
      "setFlagOnComplete": "ritual_corridor_open"
    },
    {
      "id": "find_dining_way",
      "name": "The Locked Mess",
      "description": "The door from the Central Corridor into the Dining Hall is barred. Find another way — through the Kitchen, or get the Executioner's keyring from the Torture Chamber.",
      "setFlagOnComplete": "dining_hall_path_open"
    },
    {
      "id": "kill_inquisitor",
      "name": "Silence the Inquisitor",
      "description": "The freed Sorcerer wants the Inquisitor destroyed before he finishes his work in the chapel.",
      "targetEnemyId": "inquisitor_boss",
      "targetLocationId": "chapel",
      "branchId": "chapel"
    },
    {
      "id": "kill_resurrected_anarchist",
      "name": "End the Uprising",
      "description": "The Guard Captain wants the Resurrected Anarchist put down before he leads the political wing into open revolt.",
      "targetEnemyId": "corrupted_anarchist",
      "targetLocationId": "political_wing",
      "branchId": "political_wing"
    }
  ],
  "locations": [
    {
      "id": "prison_cell",
      "name": "Prison Cell",
      "subtitle": "Starting Cell",
      "type": "start",
      "position": {
        "x": 160,
        "y": 450
      },
      "description": "Iron bars bent outward, straw scattered across the floor. A man in shackles kneels over a dead guard, and looks up at you like he already knows your name.",
      "image": "/locations/prison_cell.png",
      "visited": true,
      "discovered": true,
      "npcs": [
        {
          "id": "dead_anarchist",
          "name": "The Dead Anarchist",
          "tag": "Resurrected Prisoner",
          "description": "A resurrected political prisoner who points you at the Warden.",
          "lines": [
            "You're not the one I came for. But the door's open regardless.",
            "They buried me for a revolution I never finished. Seems I'm needed again.",
            "The Warden still gives orders from his tower, dead or not. Kill him, and this fortress falls apart."
          ],
          "image": "/characters/dead_anarchist.png",
          "talked": false,
          "grantsQuestId": "kill_warden"
        }
      ],
      "loot": [
        {
          "id": "prisoners_shiv",
          "name": "Prisoner's Shiv",
          "description": "1 damage · always in hand",
          "claimed": false
        }
      ],
      "interactions": [
        {
          "id": "talk_dead_anarchist",
          "action": "TALK",
          "label": "Talk to the Dead Anarchist",
          "requiresNpc": true,
          "targetId": "dead_anarchist",
          "once": true
        },
        {
          "id": "search_cell",
          "action": "SEARCH",
          "label": "Search the cell",
          "requiresLoot": true,
          "once": true
        },
        {
          "id": "explore_cell",
